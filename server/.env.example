DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/netxe_dev?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo"
PORT=4000

# Pruebas (npm test): por defecto usan la misma conexión con la base «netxe_test».
# DATABASE_URL_PRUEBAS="postgresql://USUARIO:CONTRASENA@localhost:5432/netxe_test?schema=public"

# Dirección del cliente, para los enlaces de los correos
APP_URL="http://localhost:5173"

# Correo (opcional). Sin SMTP_HOST, los correos se guardan en server/correos/
# y el enlace se muestra en la consola del servidor.
# Ejemplo con Gmail: crea una «contraseña de aplicación» en tu cuenta de Google.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="contraseña-de-aplicación"
# CORREO_REMITENTE="Net-Xe <tu-correo@gmail.com>"
