// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  PROPONENTE
  SOLICITANTE
}

enum AccountType {
  INDIVIDUAL
  EMPRESA
}

enum ContractState {
  PENDIENTE
  FIRMADO
  RECHAZADO
  EN_REVISION
}

enum ContractType {
  INDEFINIDO
  PLAZO_FIJO
  OBRA_FAENA
  JORNADA_PARCIAL
  REEMPLAZO
  APRENDIZAJE
  HONORARIOS
  SERVICIOS_PROFESIONALES
  MANDATO
  ARRENDAMIENTO_SERVICIOS
  COMPRAVENTA_BIENES
  COMPRAVENTA_DOMINIO
  COMPRAVENTA_INTERNACIONAL
  SOCIEDAD
  SUMINISTRO
  FRANQUICIA
  LEASING
  FACTORING
  DISTRIBUCION
  AGENCIA
  ARRIENDO
  COMODATO
  DONACION
  MUTUO
  HIPOTECA
  EJECUCION_INMEDIATA
  TRACTO_SUCESIVO
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  company      String?
  phone        String?
  accountType  AccountType    @default(INDIVIDUAL)
  role         Role           @default(SOLICITANTE)
  createdAt    DateTime       @default(now())

  contratosPropuestos   Contrato[] @relation("ProponenteRelation")
  contratosSolicitados  Contrato[] @relation("SolicitanteRelation")
  mensajes              MensajeContrato[]
  documentos            DocumentoContrato[]
  acciones              AccionHistorial[]
  notificaciones        Notification[]
}

model Contrato {
  id                    Int           @id @default(autoincrement())
  tipo                  ContractType
  estado                ContractState @default(PENDIENTE)

  solicitanteId         Int
  proponenteId          Int

  datos                 Json

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  firmadoSolicitante    Boolean       @default(false)
  firmadoProponente     Boolean       @default(false)

  fechaFirmaSolicitante DateTime?
  fechaFirmaProponente  DateTime?

  firmaSolicitanteHash  String?
  firmaProponenteHash   String?

  pinFirma              String?

  solicitante User @relation("SolicitanteRelation", fields: [solicitanteId], references: [id])
  proponente  User @relation("ProponenteRelation", fields: [proponenteId], references: [id])

  acciones    AccionHistorial[]
  mensajes    MensajeContrato[]
  documentos  DocumentoContrato[]
}

model AccionHistorial {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  evento      String
  comentario  String?
  fecha       DateTime  @default(now()) // cuándo ocurrió el evento

  contrato    Contrato  @relation(fields: [contratoId], references: [id])
  usuario     User      @relation(fields: [usuarioId], references: [id])
}


model MensajeContrato {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  mensaje     String
  fecha       DateTime @default(now())

  contrato    Contrato @relation(fields: [contratoId], references: [id])
  usuario     User     @relation(fields: [usuarioId], references: [id])
}

model DocumentoContrato {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  nombre      String
  url         String
  tipo        String
  fecha       DateTime   @default(now())

  contrato    Contrato @relation(fields: [contratoId], references: [id])
  usuario     User     @relation(fields: [usuarioId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  mensaje   String
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  usuario   User     @relation(fields: [usuarioId], references: [id])
}
