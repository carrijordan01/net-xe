// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOLICITANTE
  CONTRAPARTE
}

enum AccountType {
  INDIVIDUAL
  EMPRESA
}

enum ContractState {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  FIRMADO
  ELIMINADO
}

enum ContractType {
  INDEFINIDO
  PLAZO_FIJO
  JORNADA_PARCIAL
  OBRA_FAENA
  REEMPLAZO
  SERVICIOS_PROFESIONALES
  COMPRAVENTA_BIENES
  COMPRAVENTA_DOMINIO
  AGENCIA
  DISTRIBUCION
  SUMINISTRO
  ARRIENDO
  COMODATO
  DONACION
  MUTUO
  CONTRATO_SIMPLE
}

enum Modalidad {
  EJECUCION_INMEDIATA
  TRACTO_SUCESIVO
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  company      String?
  phone        String?
  accountType  AccountType    @default(INDIVIDUAL)
  role         Role           @default(SOLICITANTE)
  createdAt    DateTime       @default(now())

  // Firma electrónica: PIN adicional y bloqueo por intentos fallidos
  pinFirmaHash           String?
  intentosFirmaFallidos  Int       @default(0)
  firmaBloqueadaHasta    DateTime?

  // Las sesiones (JWT) emitidas antes de esta fecha dejan de ser válidas
  credencialesCambiadasEn DateTime?

  contratosRecibidos    Contrato[] @relation("ContraparteRelation")
  contratosSolicitados  Contrato[] @relation("SolicitanteRelation")
  mensajes              MensajeContrato[]
  documentos            DocumentoContrato[]
  acciones              AccionHistorial[]
  notificaciones        Notification[]
  solicitudesCambio     SolicitudCambio[] @relation("SolicitudesCreadas")
  bloqueosHechos        Bloqueo[]  @relation("BloqueosHechos")
  bloqueosRecibidos     Bloqueo[]  @relation("BloqueosRecibidos")
  recuperaciones        RecuperacionPassword[]
}

// Un usuario bloquea a otro: no pueden ofrecerse contratos entre ellos y
// quien bloquea deja de ser visible para el bloqueado
model Bloqueo {
  id           Int      @id @default(autoincrement())
  bloqueadorId Int
  bloqueadoId  Int
  createdAt    DateTime @default(now())

  bloqueador   User     @relation("BloqueosHechos", fields: [bloqueadorId], references: [id])
  bloqueado    User     @relation("BloqueosRecibidos", fields: [bloqueadoId], references: [id])

  @@unique([bloqueadorId, bloqueadoId])
  @@index([bloqueadoId])
}

model Contrato {
  id                    Int           @id @default(autoincrement())
  tipo                  ContractType
  estado                ContractState @default(PENDIENTE)
  modalidad             Modalidad?
  fechaTermino          DateTime?

  solicitanteId         Int
  contraparteId         Int

  datos                 Json

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  firmadoSolicitante    Boolean       @default(false)
  firmadoContraparte    Boolean       @default(false)

  fechaFirmaSolicitante DateTime?
  fechaFirmaContraparte DateTime?

  ipFirmaSolicitante    String?
  ipFirmaContraparte    String?

  firmaSolicitanteHash  String?
  firmaContraparteHash  String?

  solicitante User @relation("SolicitanteRelation", fields: [solicitanteId], references: [id])
  contraparte User @relation("ContraparteRelation", fields: [contraparteId], references: [id])

  acciones    AccionHistorial[]
  mensajes    MensajeContrato[]
  documentos  DocumentoContrato[]
  notificaciones Notification[]
  solicitudes    SolicitudCambio[]
}

model AccionHistorial {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  evento      String
  comentario  String?
  fecha       DateTime  @default(now()) // cuándo ocurrió el evento

  contrato    Contrato  @relation(fields: [contratoId], references: [id])
  usuario     User      @relation(fields: [usuarioId], references: [id])
}


model MensajeContrato {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  mensaje     String
  fecha       DateTime @default(now())

  contrato    Contrato @relation(fields: [contratoId], references: [id])
  usuario     User     @relation(fields: [usuarioId], references: [id])
}

// Documento adjunto a un contrato. El archivo se guarda en server/uploads con
// un nombre aleatorio («archivo»); «nombre» es el nombre original para mostrar.
model DocumentoContrato {
  id          Int      @id @default(autoincrement())
  contratoId  Int
  usuarioId   Int
  nombre      String
  descripcion String?
  archivo     String   @unique
  mimeType    String
  tamano      Int
  hash        String   // SHA-256 del archivo
  fecha       DateTime @default(now())

  contrato    Contrato @relation(fields: [contratoId], references: [id])
  usuario     User     @relation(fields: [usuarioId], references: [id])

  @@index([contratoId])
}

enum TipoNotificacion {
  CONTRATO_RECIBIDO
  CONTRATO_EDITADO
  CONTRATO_ELIMINADO
  CONTRATO_ACEPTADO
  CONTRATO_RECHAZADO
  CONTRATO_FIRMADO
  VENCIMIENTO_PROXIMO
  SOLICITUD_CAMBIO
  SOLICITUD_RESPONDIDA
  DOCUMENTO_ADJUNTO
}

model Notification {
  id         Int              @id @default(autoincrement())
  usuarioId  Int
  tipo       TipoNotificacion
  mensaje    String
  leido      Boolean          @default(false)
  createdAt  DateTime         @default(now())
  contratoId Int?
  // Evita duplicar avisos generados automáticamente (p. ej. vencimientos)
  clave      String?

  usuario    User      @relation(fields: [usuarioId], references: [id])
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  @@unique([usuarioId, clave])
  @@index([usuarioId, createdAt])
}

enum TipoSolicitud {
  EDICION
  ELIMINACION
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

// Solicitud para editar o eliminar un contrato que ya tiene firmas.
// En las ediciones, «propuesta» guarda la versión nueva completa
// ({ datos, modalidad, fechaTermino }) y «cambios» las etiquetas modificadas.
model SolicitudCambio {
  id           Int             @id @default(autoincrement())
  contratoId   Int
  autorId      Int
  tipo         TipoSolicitud
  estado       EstadoSolicitud @default(PENDIENTE)
  motivo       String
  propuesta    Json?
  cambios      String[]
  respuesta    String?
  createdAt    DateTime        @default(now())
  respondidaAt DateTime?

  contrato     Contrato        @relation(fields: [contratoId], references: [id])
  autor        User            @relation("SolicitudesCreadas", fields: [autorId], references: [id])

  @@index([contratoId, estado])
}

// Solicitud de recuperación de contraseña. Se guarda solo el hash SHA-256 del
// token enviado por correo; vence a los 30 minutos y se usa una sola vez.
model RecuperacionPassword {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  tokenHash  String    @unique
  expiraEn   DateTime
  usadoEn    DateTime?
  createdAt  DateTime  @default(now())

  usuario    User      @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, createdAt])
}
